.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
.cache/

# Example outputs / large data (committed assets under examples/*/assets
# are unaffected: generated outputs land in the working directory)
examples/data/ALPSRP*
examples/data/*.bin
*_cpu.png
*_hls.cpp
/san_francisco_*.png

