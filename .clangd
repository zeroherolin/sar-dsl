# clangd configuration (editor-agnostic: VS Code, Neovim, CLion, ...).
# Code navigation requires the compilation database generated by the
# project build: run `make build` once, then restart clangd.
CompileFlags:
  CompilationDatabase: build
Diagnostics:
  # TableGen-generated .inc includes trigger false unused-include warnings.
  UnusedIncludes: None
